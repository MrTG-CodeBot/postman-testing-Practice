{
  "info": {
    "name": "TMDB Chapter 04 - Discover and Filtering",
    "_postman_id": "tmdb-ch04-discover",
    "description": "Chapter 04: Filtering movies with /discover/movie and asserting every element in the response array.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Get Movie Genres List",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Genres list is not empty\", function () {",
              "    var genres = pm.response.json().genres;",
              "    pm.expect(genres).to.be.an(\"array\").that.is.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{tmdb_token}}", "type": "string" }
          ]
        },
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/genre/movie/list?language=en",
          "host": ["{{baseUrl}}"],
          "path": ["genre", "movie", "list"],
          "query": [
            { "key": "language", "value": "en" }
          ]
        }
      }
    },
    {
      "name": "2. Discover Filtered Sci-Fi Movies",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Every movie has at least 500 votes and Sci-Fi genre (878)\", function () {",
              "    var movies = pm.response.json().results;",
              "    pm.expect(movies).to.be.an(\"array\").that.is.not.empty;",
              "",
              "    movies.forEach(function (movie) {",
              "        pm.expect(movie.vote_count).to.be.at.least(500);",
              "        pm.expect(movie.genre_ids).to.include(878);",
              "    });",
              "});",
              "",
              "pm.test(\"Results are sorted by vote_average descending\", function () {",
              "    var movies = pm.response.json().results;",
              "    for (var i = 0; i < movies.length - 1; i++) {",
              "        pm.expect(movies[i].vote_average).to.be.at.least(movies[i + 1].vote_average);",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{tmdb_token}}", "type": "string" }
          ]
        },
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/discover/movie?with_genres=878&primary_release_date.gte=2010-01-01&vote_count.gte=500&sort_by=vote_average.desc",
          "host": ["{{baseUrl}}"],
          "path": ["discover", "movie"],
          "query": [
            { "key": "with_genres", "value": "878" },
            { "key": "primary_release_date.gte", "value": "2010-01-01" },
            { "key": "vote_count.gte", "value": "500" },
            { "key": "sort_by", "value": "vote_average.desc" }
          ]
        }
      }
    }
  ]
}